{
  "manifest_version": 3,
  "name": "HealthKey Authenticator",
  "version": "1.4.0",
  "description": "Biometric & TOTP authentication via HealthKey-Ulta wearable",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}