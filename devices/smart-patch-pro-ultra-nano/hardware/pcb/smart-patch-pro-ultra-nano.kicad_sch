  (title_block
    (title "Smart Patch Pro Ultra Nano — Main PCB Schematic")
    (date "2026-06-01")
    (rev "A")
    (company "Embedded Operating Systems Research Foundation")
    (comment 1 "Inventor: Srikanth Patchava")
    (comment 2 "Patent Pending — Novel claims: NEBA, DMSA, SCBN")
    (comment 3 "EIN: 41-4821627")
    (comment 4 "2-layer flex PCB, 0.1 mm total thickness, polyimide substrate")
    (comment 5 "Biosensor array: aerosol jet printed Pt-black on 0.05mm Kapton")
  )

  ;; ============================================================
  ;; POWER RAILS
  ;; VBAT  = 3.7V (flexible LiPo battery)
  ;; VDD   = 1.8V (nRF52840 core)
  ;; VDDIO = 3.0V (I/O and sensors)
  ;; VBIO  = 3.3V (biosensor analog supply, low-noise LDO)
  ;; VIONTO = ±1.5V (iontophoresis H-bridge supply)
  ;; ============================================================

  ;; ============================================================
  ;; U1 — Nordic nRF52840 (Main MCU + BLE 5.3)
  ;; Package: QFN-73, 7×7 mm
  ;; ============================================================
  ;; Connections:
  ;; VDD (pin 1,2,3)        → VDD rail (1.8V)
  ;; VDDIO (pin 4,5,6)      → VDDIO rail (3.0V)
  ;; GND (pin 7,8,9,10)     → GND
  ;; P0.00 / XL1            → 32.768 kHz crystal X1 pin 1
  ;; P0.01 / XL2            → 32.768 kHz crystal X1 pin 2
  ;; P0.06                  → SPI_CLK (MAX30101)
  ;; P0.07                  → SPI_MOSI
  ;; P0.08                  → SPI_MISO
  ;; P0.09                  → CS_PPG (MAX30101)
  ;; P0.11                  → INT_PPG (MAX30101 interrupt)
  ;; P0.13                  → I2C_SCL (LMP91000×3, MAX30208, LIS2DH12, MAX77734)
  ;; P0.14                  → I2C_SDA
  ;; P0.15                  → INT_IMU (LIS2DH12 interrupt)
  ;; P0.16                  → INT_TEMP (MAX30208 interrupt)
  ;; P0.17                  → UART_TX (debug)
  ;; P0.18                  → UART_RX (debug)
  ;; P0.19                  → IONTO_EN (iontophoresis enable)
  ;; P0.20                  → IONTO_DIR (iontophoresis direction)
  ;; P0.21                  → IONTO_SENSE (current sense ADC)
  ;; P0.22                  → MUX_A0 (electrode multiplexer address bit 0)
  ;; P0.23                  → MUX_A1 (electrode multiplexer address bit 1)
  ;; P0.24                  → NFC_AN1 (NFC antenna)
  ;; P0.25                  → NFC_AN2 (NFC antenna)
  ;; P0.26                  → PMIC_INT (MAX77734 interrupt)
  ;; P0.27                  → PMIC_EN
  ;; P0.28 (AIN4)           → VBAT_SENSE (battery voltage divider)
  ;; P0.29 (AIN5)           → WEAR_DETECT (skin contact impedance)
  ;; P1.00                  → LMP91000_ADDR0 (I2C address select)
  ;; P1.01                  → LMP91000_ADDR1
  ;; P1.02                  → LMP91000_ADDR2
  ;; DECAP: 100nF + 10µF on each VDD/VDDIO pin

  ;; ============================================================
  ;; U2, U3, U4 — Texas Instruments LMP91000 (Potentiostat ICs × 3)
  ;; Package: WSON-10, 3.0×3.0 mm
  ;; ============================================================
  ;; U2 (LMP91000 #1) — Glucose + Lactate group
  ;; I2C address: 0x48 (ADDR pin → GND via P1.00)
  ;; VDD (pin 1)            → VBIO rail (3.3V)
  ;; GND (pin 2)            → GND
  ;; SCL (pin 3)            → I2C_SCL (nRF52840 P0.13)
  ;; SDA (pin 4)            → I2C_SDA (nRF52840 P0.14)
  ;; MENB (pin 5)           → nRF52840 P1.00 (module enable)
  ;; C1 (pin 6)             → Working electrode W1 (glucose, GOx)
  ;; C2 (pin 7)             → Working electrode W2 (lactate, LOx)
  ;; VOUT (pin 8)           → 100nF to GND (output filter)
  ;; REF (pin 9)            → Reference electrode R1 (Ag/AgCl)
  ;; CE (pin 10)            → Counter electrode CE1
  ;; DECAP: 100nF + 10µF on VDD

  ;; U3 (LMP91000 #2) — Cortisol + Uric Acid group
  ;; I2C address: 0x49 (ADDR pin → VDD via P1.01)
  ;; (same pin connections as U2, different electrode assignments)
  ;; C1 → Working electrode W3 (cortisol, MIP)
  ;; C2 → Working electrode W4 (uric acid, UOx)
  ;; REF → Reference electrode R2 (Ag/AgCl)
  ;; CE  → Counter electrode CE2

  ;; U4 (LMP91000 #3) — Na⁺ / K⁺ / pH group
  ;; I2C address: 0x4A (ADDR pin → SCL via P1.02)
  ;; C1 → Working electrode W5 (sodium ISE)
  ;; C2 → Working electrode W6 (potassium ISE)
  ;; C3 → Working electrode W7 (pH IrOx)
  ;; REF → Reference electrode R3 (Ag/AgCl)
  ;; CE  → Counter electrode CE3

  ;; ============================================================
  ;; U5 — Maxim MAX30101 (PPG AFE)
  ;; Package: WLP-14, 1.8×1.8 mm
  ;; ============================================================
  ;; (same connections as Smart Ring Pro Nano — see Nano schematic)

  ;; ============================================================
  ;; U6 — Maxim MAX30208 (Temperature Sensor)
  ;; Package: WLP-9, 1.0×1.0 mm
  ;; ============================================================
  ;; (same I2C connections as Smart Ring Pro Ultra — see Ultra schematic)

  ;; ============================================================
  ;; U7 — ST LIS2DH12 (Ultra-Low Power 3-axis Accelerometer)
  ;; Package: LGA-12, 2.0×2.0 mm
  ;; ============================================================
  ;; VDD (pin 1)            → VDDIO rail (3.0V)
  ;; VDDIO (pin 2)          → VDDIO rail (3.0V)
  ;; GND (pin 3,4)          → GND
  ;; SCL (pin 5)            → I2C_SCL (nRF52840 P0.13)
  ;; SDA (pin 6)            → I2C_SDA (nRF52840 P0.14)
  ;; SDO/SA0 (pin 7)        → GND (I2C address 0x18)
  ;; CS (pin 8)             → VDD (I2C mode)
  ;; INT1 (pin 9)           → nRF52840 P0.15
  ;; DECAP: 100nF + 1µF on VDD, VDDIO

  ;; ============================================================
  ;; U8 — Maxim MAX77734 (PMIC)
  ;; Package: WLP-16, 1.6×1.6 mm
  ;; ============================================================
  ;; (same connections as Smart Ring Pro Ultra — see Ultra schematic)
  ;; Additional: BUCK2OUT → VBIO rail (3.3V, 200mA, low-noise)

  ;; ============================================================
  ;; U9 — TI TPS61099 (Boost Converter for iontophoresis)
  ;; Package: SOT-23-5, 2.9×1.6 mm
  ;; ============================================================
  ;; VIN (pin 1)            → VBAT rail (3.7V)
  ;; GND (pin 2)            → GND
  ;; EN (pin 3)             → nRF52840 P0.19 (IONTO_EN)
  ;; SW (pin 4)             → 4.7µH inductor → VOUT
  ;; VOUT (pin 5)           → VIONTO rail (5.0V, 100mA)
  ;; DECAP: 10µF on VIN, VOUT

  ;; ============================================================
  ;; IONTO — Iontophoresis H-Bridge
  ;; Discrete MOSFETs: 4× AO3401A (P-channel, 30V, 4A)
  ;; ============================================================
  ;; H-bridge configuration:
  ;; High-side Q1 (P-ch): VIONTO → IONTO_OUT+
  ;; High-side Q2 (P-ch): VIONTO → IONTO_OUT-
  ;; Low-side Q3 (P-ch):  IONTO_OUT+ → GND
  ;; Low-side Q4 (P-ch):  IONTO_OUT- → GND
  ;; Current sense: 10Ω shunt + INA213 (TI) → nRF52840 AIN5
  ;; IONTO_OUT+ → Iontophoresis anode electrode (IA)
  ;; IONTO_OUT- → Iontophoresis cathode electrode (IC)
  ;; Max current: 300 µA (software-limited via PWM duty cycle)

  ;; ============================================================
  ;; B1 — Grepow GRP3040 (45 mAh Flexible LiPo)
  ;; Package: Custom flexible, 30×40×0.5 mm
  ;; ============================================================
  ;; BATT+ → MAX77734 BATT pin
  ;; BATT- → GND

  ;; ============================================================
  ;; L1 — TDK WCT-1501 (NFC Charging Coil, flexible)
  ;; Resonant frequency: 13.56 MHz
  ;; ============================================================
  ;; COIL1 → nRF52840 NFC_AN1 (P0.24) + MAX77734 CHGIN (via rectifier)
  ;; COIL2 → nRF52840 NFC_AN2 (P0.25) + GND

  ;; ============================================================
  ;; BIOSENSOR ARRAY — EOS-NEBA-01
  ;; Aerosol jet printed Pt-black on 0.05mm Kapton
  ;; 7 working electrodes + 3 Ag/AgCl reference + 3 counter electrodes
  ;; ============================================================
  ;; W1 (glucose GOx)       → LMP91000 U2 C1
  ;; W2 (lactate LOx)       → LMP91000 U2 C2
  ;; W3 (cortisol MIP)      → LMP91000 U3 C1
  ;; W4 (uric acid UOx)     → LMP91000 U3 C2
  ;; W5 (sodium ISE)        → LMP91000 U4 C1
  ;; W6 (potassium ISE)     → LMP91000 U4 C2
  ;; W7 (pH IrOx)           → LMP91000 U4 C3
  ;; R1 (Ag/AgCl ref #1)    → LMP91000 U2 REF
  ;; R2 (Ag/AgCl ref #2)    → LMP91000 U3 REF
  ;; R3 (Ag/AgCl ref #3)    → LMP91000 U4 REF
  ;; CE1 (counter #1)       → LMP91000 U2 CE
  ;; CE2 (counter #2)       → LMP91000 U3 CE
  ;; CE3 (counter #3)       → LMP91000 U4 CE
  ;; IA (iontophoresis +)   → H-bridge IONTO_OUT+
  ;; IC (iontophoresis -)   → H-bridge IONTO_OUT-

  ;; ============================================================
  ;; X1 — 32.768 kHz Crystal (RTC)
  ;; ============================================================
  ;; Pin 1 → nRF52840 XL1 (P0.00) via 12pF to GND
  ;; Pin 2 → nRF52840 XL2 (P0.01) via 12pF to GND

  ;; ============================================================
  ;; J1 — Debug/Programming Header (Test pads, 0.5mm pitch)
  ;; ============================================================
  ;; Pin 1: VDD
  ;; Pin 2: GND
  ;; Pin 3: SWDIO (nRF52840)
  ;; Pin 4: SWDCLK (nRF52840)
  ;; Pin 5: UART_TX
  ;; Pin 6: UART_RX

)
