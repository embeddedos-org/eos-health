# eBuild Configuration — Smart Patch Pro Ultra Nano Firmware
# EmbeddedOS Build System v2.1

[project]
name = smart-patch-pro-ultra-nano
version = 0.1.0
description = "Smart Patch Pro Ultra Nano — 14-day multi-analyte biosensor patch firmware"
inventor = "Srikanth Patchava"
organization = "Embedded Operating Systems Research Foundation"

[board]
target = smart-patch-pro-ultra-nano-rev-a
mcu = nrf52840
rtos = zephyr-3.6
toolchain = arm-none-eabi-gcc-13.2

[features]
ble = true
ble_version = 5.3
ota = true
nfc_charging = true
biosensor_electrochemical = true
iontophoresis = true
ppg = true
temperature = true
accelerometer = true
self_calibration = true

[sensors]
potentiostat_ic = lmp91000
potentiostat_count = 3
ppg_ic = max30101
temp_ic = max30208
accel_ic = lis2dh12
biosensor_array = eos-neba-01
analytes = glucose,lactate,cortisol,sodium,potassium,uric_acid,ph

[power]
pmic = max77734
battery_mah = 45
battery_chemistry = flexible_lipo
charging_method = nfc_inductive
charging_frequency_mhz = 13.56
target_battery_life_days = 14

[iontophoresis]
max_current_ua = 300
default_current_ua = 200
pulse_on_seconds = 30
pulse_off_seconds = 270
h_bridge_ic = discrete_mosfet
current_sense_ic = ina213

[calibration]
reference_electrodes = 3
calibration_method = scbn
kalman_filter = true
temperature_compensation = true
drift_correction_interval_min = 30

[ble_services]
biochemical_monitoring = custom
health_monitoring = 0x181D
activity = 0x1814
calibration = custom
device_info = 0x180A
ota_update = custom

[build]
optimization = Os
debug_uart = true
debug_baud = 115200
flash_size_kb = 1024
ram_size_kb = 256
