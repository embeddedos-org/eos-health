  (paper "A4")
  (title_block
    (title "Smart Ring Pro Ultra — Main PCB Schematic")
    (date "2026-06-01")
    (rev "A")
    (company "Embedded Operating Systems Research Foundation")
    (comment 1 "Inventor: Srikanth Patchava")
    (comment 2 "Patent Pending — Novel claims: DAEA, MSHE, PPTT")
    (comment 3 "EIN: 41-4821627")
    (comment 4 "4-layer flex PCB, 0.2 mm total thickness, polyimide substrate")
  )

  ;; ============================================================
  ;; POWER RAILS
  ;; VBAT  = 3.7V (LiPo battery)
  ;; VDD   = 1.8V (nRF52840 core)
  ;; VDDIO = 3.0V (I/O and sensors)
  ;; VSENS = 3.3V (analog sensor supply)
  ;; ============================================================

  ;; ============================================================
  ;; U1 — Nordic nRF52840 (Main MCU + BLE 5.3)
  ;; Package: QFN-73, 7×7 mm
  ;; ============================================================
  ;; Connections:
  ;; VDD (pin 1,2,3)        → VDD rail (1.8V)
  ;; VDDIO (pin 4,5,6)      → VDDIO rail (3.0V)
  ;; GND (pin 7,8,9,10)     → GND
  ;; P0.00 / XL1            → 32.768 kHz crystal X1 pin 1
  ;; P0.01 / XL2            → 32.768 kHz crystal X1 pin 2
  ;; P0.04 (AIN2)           → GSR electrode 1 (E1)
  ;; P0.05 (AIN3)           → GSR electrode 2 (E2)
  ;; P0.06                  → SPI_CLK (MAX86176, MAX30003)
  ;; P0.07                  → SPI_MOSI
  ;; P0.08                  → SPI_MISO
  ;; P0.09                  → CS_PPG (MAX86176)
  ;; P0.10                  → CS_ECG (MAX30003)
  ;; P0.11                  → INT_PPG (MAX86176 interrupt)
  ;; P0.12                  → INT_ECG (MAX30003 interrupt)
  ;; P0.13                  → I2C_SCL (MAX30208, LSM6DSO32, SGP41, BMP390)
  ;; P0.14                  → I2C_SDA
  ;; P0.15                  → INT_IMU (LSM6DSO32 interrupt)
  ;; P0.16                  → INT_TEMP (MAX30208 interrupt)
  ;; P0.17                  → UART_TX (debug)
  ;; P0.18                  → UART_RX (debug)
  ;; P0.19                  → SPI_CLK2 (MAX32666 co-processor)
  ;; P0.20                  → SPI_MOSI2
  ;; P0.21                  → SPI_MISO2
  ;; P0.22                  → CS_AI (MAX32666)
  ;; P0.23                  → HAPTIC_EN (haptic motor)
  ;; P0.24                  → NFC_AN1 (NFC antenna)
  ;; P0.25                  → NFC_AN2 (NFC antenna)
  ;; P0.26                  → PMIC_INT (MAX77734 interrupt)
  ;; P0.27                  → PMIC_EN
  ;; P0.28 (AIN4)           → VBAT_SENSE (battery voltage divider)
  ;; P1.00                  → LED_EN (LED array power enable)
  ;; P1.01                  → PIEZO_INT (PKGS-00ZX1 interrupt)
  ;; DECAP: 100nF + 10µF on each VDD/VDDIO pin
  ;; ANTENNA: 50Ω trace to PCB antenna (layer 4)

  ;; ============================================================
  ;; U2 — Maxim MAX32666 (AI Co-processor)
  ;; Package: WLP-81, 2.7×2.7 mm
  ;; ============================================================
  ;; Connections:
  ;; VDD (pin A1,A2)        → VDD rail (1.8V)
  ;; VDDIOH (pin B1,B2)     → VDDIO rail (3.0V)
  ;; GND (pin C1,C2,D1)     → GND
  ;; SPI_CLK (pin E1)       → nRF52840 P0.19
  ;; SPI_MOSI (pin E2)      → nRF52840 P0.20
  ;; SPI_MISO (pin E3)      → nRF52840 P0.21
  ;; CS (pin E4)            → nRF52840 P0.22
  ;; RESET (pin F1)         → nRF52840 GPIO (P1.02)
  ;; WAKE (pin F2)          → nRF52840 GPIO (P1.03)
  ;; DECAP: 100nF + 4.7µF on VDD, VDDIOH

  ;; ============================================================
  ;; U3 — Maxim MAX86176 (5-wavelength PPG AFE)
  ;; Package: WLP-30, 2.0×2.5 mm
  ;; ============================================================
  ;; Connections:
  ;; AVDD (pin 1)           → VSENS rail (3.3V) via 10Ω ferrite
  ;; DVDD (pin 2)           → VDDIO rail (3.0V)
  ;; GND (pin 3,4)          → GND
  ;; SCLK (pin 5)           → nRF52840 P0.06
  ;; MOSI (pin 6)           → nRF52840 P0.07
  ;; MISO (pin 7)           → nRF52840 P0.08
  ;; CS (pin 8)             → nRF52840 P0.09
  ;; INT (pin 9)            → nRF52840 P0.11
  ;; LED_DRV1 (pin 10)      → LED1 660nm (cathode)
  ;; LED_DRV2 (pin 11)      → LED2 730nm (cathode)
  ;; LED_DRV3 (pin 12)      → LED3 850nm (cathode)
  ;; LED_DRV4 (pin 13)      → LED4 940nm (cathode)
  ;; LED_DRV5 (pin 14)      → LED5 1300nm (cathode)
  ;; PD1 (pin 15)           → Photodetector PD1 anode
  ;; PD2 (pin 16)           → Photodetector PD2 anode
  ;; DECAP: 100nF + 10µF on AVDD; 100nF on DVDD

  ;; ============================================================
  ;; U4 — Maxim MAX30003 (ECG AFE)
  ;; Package: WLP-20, 1.8×1.8 mm
  ;; ============================================================
  ;; Connections:
  ;; AVDD (pin 1)           → VSENS rail (3.3V) via 10Ω ferrite
  ;; DVDD (pin 2)           → VDDIO rail (3.0V)
  ;; GND (pin 3)            → GND
  ;; SCLK (pin 4)           → nRF52840 P0.06
  ;; MOSI (pin 5)           → nRF52840 P0.07
  ;; MISO (pin 6)           → nRF52840 P0.08
  ;; CS (pin 7)             → nRF52840 P0.10
  ;; INT (pin 8)            → nRF52840 P0.12
  ;; ECGP (pin 9)           → ECG electrode E1 (via 1MΩ + 4.7nF ESD)
  ;; ECGN (pin 10)          → ECG electrode E2 (via 1MΩ + 4.7nF ESD)
  ;; RBIAS (pin 11)         → 196kΩ to GND
  ;; DECAP: 100nF + 4.7µF on AVDD; 100nF on DVDD

  ;; ============================================================
  ;; U5 — Maxim MAX30208 (Temperature Sensor)
  ;; Package: WLP-9, 1.0×1.0 mm
  ;; ============================================================
  ;; Connections:
  ;; VDD (pin 1)            → VDDIO rail (3.0V)
  ;; GND (pin 2)            → GND
  ;; SCL (pin 3)            → I2C_SCL (nRF52840 P0.13)
  ;; SDA (pin 4)            → I2C_SDA (nRF52840 P0.14)
  ;; INT (pin 5)            → nRF52840 P0.16
  ;; ADDR (pin 6)           → GND (I2C address 0x50)
  ;; DECAP: 100nF on VDD

  ;; ============================================================
  ;; U6 — ST LSM6DSO32 (6-axis IMU)
  ;; Package: LGA-14L, 2.5×3.0 mm
  ;; ============================================================
  ;; Connections:
  ;; VDD (pin 1)            → VDDIO rail (3.0V)
  ;; VDDIO (pin 2)          → VDDIO rail (3.0V)
  ;; GND (pin 3,4)          → GND
  ;; SCL/SPC (pin 5)        → I2C_SCL (nRF52840 P0.13)
  ;; SDA/SDI (pin 6)        → I2C_SDA (nRF52840 P0.14)
  ;; SDO/SA0 (pin 7)        → GND (I2C address 0x6A)
  ;; CS (pin 8)             → VDD (I2C mode)
  ;; INT1 (pin 9)           → nRF52840 P0.15
  ;; INT2 (pin 10)          → nRF52840 P1.04
  ;; DECAP: 100nF + 1µF on VDD, VDDIO

  ;; ============================================================
  ;; U7 — Sensirion SGP41 (VOC/NOx Gas Sensor)
  ;; Package: DFN-6, 2.44×2.44 mm
  ;; ============================================================
  ;; Connections:
  ;; VDD (pin 1)            → VDDIO rail (3.0V)
  ;; GND (pin 2)            → GND
  ;; SCL (pin 3)            → I2C_SCL (nRF52840 P0.13)
  ;; SDA (pin 4)            → I2C_SDA (nRF52840 P0.14)
  ;; DECAP: 100nF + 10µF on VDD

  ;; ============================================================
  ;; U8 — Bosch BMP390 (Barometric Pressure)
  ;; Package: LGA-10, 2.0×2.0 mm
  ;; ============================================================
  ;; Connections:
  ;; VDD (pin 1)            → VDDIO rail (3.0V)
  ;; VDDIO (pin 2)          → VDDIO rail (3.0V)
  ;; GND (pin 3,4)          → GND
  ;; SCL (pin 5)            → I2C_SCL (nRF52840 P0.13)
  ;; SDA (pin 6)            → I2C_SDA (nRF52840 P0.14)
  ;; SDO (pin 7)            → GND (I2C address 0x76)
  ;; CS (pin 8)             → VDD (I2C mode)
  ;; INT (pin 9)            → nRF52840 P1.05
  ;; DECAP: 100nF on VDD, VDDIO

  ;; ============================================================
  ;; U9 — Maxim MAX77734 (PMIC — Charger + LDO + Buck)
  ;; Package: WLP-16, 1.6×1.6 mm
  ;; ============================================================
  ;; Connections:
  ;; BATT (pin 1)           → B1 battery positive (3.7V)
  ;; GND (pin 2,3)          → GND
  ;; CHGIN (pin 4)          → NFC charging coil output (rectified)
  ;; SYS (pin 5)            → VBAT rail
  ;; LDO1OUT (pin 6)        → VDD rail (1.8V, 200mA)
  ;; LDO2OUT (pin 7)        → VDDIO rail (3.0V, 150mA)
  ;; BUCK1OUT (pin 8)       → VSENS rail (3.3V, 300mA)
  ;; SCL (pin 9)            → I2C_SCL (nRF52840 P0.13)
  ;; SDA (pin 10)           → I2C_SDA (nRF52840 P0.14)
  ;; INT (pin 11)           → nRF52840 P0.26
  ;; EN (pin 12)            → nRF52840 P0.27
  ;; DECAP: 10µF + 100nF on BATT, SYS; 4.7µH inductor on BUCK1

  ;; ============================================================
  ;; B1 — Cymbet CBC050 (25 mAh Solid-State LiPo)
  ;; Package: Custom thin-film, 12×10×0.2 mm
  ;; ============================================================
  ;; Connections:
  ;; BATT+ → MAX77734 BATT pin
  ;; BATT- → GND

  ;; ============================================================
  ;; L1 — TDK WCT-1001 (NFC Charging Coil)
  ;; Resonant frequency: 13.56 MHz
  ;; ============================================================
  ;; Connections:
  ;; COIL1 → nRF52840 NFC_AN1 (P0.24) + MAX77734 CHGIN (via rectifier)
  ;; COIL2 → nRF52840 NFC_AN2 (P0.25) + GND

  ;; ============================================================
  ;; E1, E2 — Platinum-Iridium Arc Electrodes (ECG + GSR)
  ;; Custom part: EOS-PTIR-01
  ;; ============================================================
  ;; E1 → MAX30003 ECGP + nRF52840 AIN2 (GSR channel 1)
  ;; E2 → MAX30003 ECGN + nRF52840 AIN3 (GSR channel 2)
  ;; ESD protection: 4.7nF + 1MΩ on each electrode line

  ;; ============================================================
  ;; LED1–5 — Multi-wavelength LED Array (Osram SFH7050 equivalent)
  ;; ============================================================
  ;; LED1 (660nm):  Anode → VSENS via 22Ω; Cathode → MAX86176 LED_DRV1
  ;; LED2 (730nm):  Anode → VSENS via 22Ω; Cathode → MAX86176 LED_DRV2
  ;; LED3 (850nm):  Anode → VSENS via 22Ω; Cathode → MAX86176 LED_DRV3
  ;; LED4 (940nm):  Anode → VSENS via 22Ω; Cathode → MAX86176 LED_DRV4
  ;; LED5 (1300nm): Anode → VSENS via 22Ω; Cathode → MAX86176 LED_DRV5

  ;; ============================================================
  ;; PD1, PD2 — Photodetector Array (Hamamatsu S13773)
  ;; ============================================================
  ;; PD1 Anode → MAX86176 PD1; Cathode → GND
  ;; PD2 Anode → MAX86176 PD2; Cathode → GND

  ;; ============================================================
  ;; PIEZO — Murata PKGS-00ZX1 (Pulse Wave Velocity)
  ;; Package: SMD, 3.0×2.5 mm
  ;; ============================================================
  ;; Signal+ → nRF52840 AIN5 (P0.29) via 10MΩ + 100pF
  ;; Signal- → GND
  ;; INT     → nRF52840 P1.01

  ;; ============================================================
  ;; X1 — 32.768 kHz Crystal (RTC)
  ;; ============================================================
  ;; Pin 1 → nRF52840 XL1 (P0.00) via 12pF to GND
  ;; Pin 2 → nRF52840 XL2 (P0.01) via 12pF to GND

  ;; ============================================================
  ;; J1 — Debug/Programming Header (Test pads, 0.5mm pitch)
  ;; ============================================================
  ;; Pin 1: VDD
  ;; Pin 2: GND
  ;; Pin 3: SWDIO (nRF52840)
  ;; Pin 4: SWDCLK (nRF52840)
  ;; Pin 5: UART_TX
  ;; Pin 6: UART_RX

)
