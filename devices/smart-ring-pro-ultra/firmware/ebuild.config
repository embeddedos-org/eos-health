# eBuild Configuration — Smart Ring Pro Ultra Firmware
# EmbeddedOS Build System v2.1

[project]
name = smart-ring-pro-ultra
version = 0.1.0
description = "Smart Ring Pro Ultra — Flagship health monitoring ring firmware"
inventor = "Srikanth Patchava"
organization = "Embedded Operating Systems Research Foundation"

[board]
target = smart-ring-pro-ultra-rev-a
mcu = nrf52840
co_processor = max32666
rtos = zephyr-3.6
toolchain = arm-none-eabi-gcc-13.2

[features]
ble = true
ble_version = 5.3
ota = true
tflite_micro = true
nfc_charging = true
ecg = true
ppg_5wavelength = true
temperature = true
imu = true
gsr = true
gas_sensor = true
barometric_pressure = true
piezo_pwv = true
haptic = true

[sensors]
ppg_ic = max86176
ecg_ic = max30003
temp_ic = max30208
imu_ic = lsm6dso32
gas_ic = sgp41
pressure_ic = bmp390
pwv_ic = pkgs-00zx1

[power]
pmic = max77734
battery_mah = 25
battery_chemistry = solid_state_lipo
charging_method = nfc_inductive
charging_frequency_mhz = 13.56
target_battery_life_days = 7

[ml_models]
arrhythmia = models/arrhythmia_int8.tflite
sleep_staging = models/sleep_staging_int8.tflite
stress_scoring = models/stress_int8.tflite
blood_pressure = models/bp_estimation_int8.tflite
ml_runtime = tflite_micro
ml_processor = max32666

[ble_services]
health_monitoring = 0x181D
activity = 0x1814
sleep = custom
stress = custom
metabolic = custom
device_info = 0x180A
ota_update = custom

[build]
optimization = Os
debug_uart = true
debug_baud = 115200
flash_size_kb = 1024
ram_size_kb = 256
