# eBuild Configuration — HEALTH-LAB Firmware
# EmbeddedOS Build System v2.1
# Covers both HEALTH-LAB (base) and HEALTH-LAB Ultra tiers

[project]
name = health-lab
version = 0.1.0
description = "HEALTH-LAB — EoS Health wearable biochemistry lab patch (base + Ultra tiers)"
inventor = "Srikanth Patchava"
organization = "Embedded Operating Systems Research Foundation"
patent_docket = "EOS-2026-004"

# ---- Base tier ----
[board.base]
target = health-lab-base-rev-a
mcu = nrf52833
rtos = zephyr-3.6
toolchain = arm-none-eabi-gcc-13.2
flash_size_kb = 512
ram_size_kb = 128

# ---- Ultra tier ----
[board.ultra]
target = health-lab-ultra-rev-a
mcu = nrf52840
rtos = zephyr-3.6
toolchain = arm-none-eabi-gcc-13.2
flash_size_kb = 1024
ram_size_kb = 256

# ---- Shared features ----
[features]
ble = true
ota = true
nfc_charging = true
electrochemical_sensing = true
temperature = true
accelerometer = true

# ---- Base-only features ----
[features.base]
potentiostat_count = 1
analytes = glucose,lactate,sodium,ph
wear_days = 7
iontophoresis = false
self_calibration = single_reference

# ---- Ultra-only features ----
[features.ultra]
potentiostat_count = 3
analytes = glucose,lactate,cortisol,uric_acid,sodium,potassium,ph
wear_days = 14
iontophoresis = true
self_calibration = scbn_kalman
ppg = true

[sensors]
potentiostat_ic = lmp91000
temp_ic = max30208
accel_ic = lis2dh12

[sensors.ultra]
ppg_ic = max30101

[iontophoresis.ultra]
max_current_ua = 300
default_current_ua = 200
pulse_on_seconds = 30
pulse_off_seconds = 270
h_bridge = discrete_mosfet
current_sense_ic = ina213

[calibration.ultra]
reference_electrodes = 3
algorithm = kalman_filter
temperature_compensation = true
drift_correction_interval_min = 30
target_accuracy_percent = 5
target_wear_days = 14

[power]
pmic = max77734
battery_chemistry = flexible_lipo
charging_method = nfc_inductive
charging_frequency_mhz = 13.56

[power.base]
battery_mah = 20
target_battery_life_days = 7

[power.ultra]
battery_mah = 45
target_battery_life_days = 14

[ble_services]
biochemical_monitoring = custom
health_monitoring = 0x181D
activity = 0x1814
calibration = custom
device_info = 0x180A
ota_update = custom

[build]
optimization = Os
debug_uart = true
debug_baud = 115200
