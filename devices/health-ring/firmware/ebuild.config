# eBuild Configuration — HEALTH-RING Firmware
# EmbeddedOS Build System v2.1
# Covers both HEALTH-RING (base) and HEALTH-RING Ultra tiers

[project]
name = health-ring
version = 0.1.0
description = "HEALTH-RING — EoS Health wearable ring (base + Ultra tiers)"
inventor = "Srikanth Patchava"
organization = "Embedded Operating Systems Research Foundation"
patent_docket = "EOS-2026-003"

# ---- Base tier ----
[board.base]
target = health-ring-base-rev-a
mcu = nrf52833
rtos = zephyr-3.6
toolchain = arm-none-eabi-gcc-13.2
flash_size_kb = 512
ram_size_kb = 128

# ---- Ultra tier ----
[board.ultra]
target = health-ring-ultra-rev-a
mcu = nrf52840
co_processor = max32666
rtos = zephyr-3.6
toolchain = arm-none-eabi-gcc-13.2
flash_size_kb = 1024
ram_size_kb = 256

# ---- Shared features ----
[features]
ble = true
ota = true
nfc_charging = true
ecg = true
ppg = true
temperature = true
imu = true
haptic = false

# ---- Base-only features ----
[features.base]
ppg_wavelengths = 3
ecg_ic = max30001
ppg_ic = max30101
zpies_electrodes = true
kehs_harvesting = true
tflite_micro = false

# ---- Ultra-only features ----
[features.ultra]
ppg_wavelengths = 5
ecg_ic = max30003
ppg_ic = max86176
daea_electrodes = true
pptt_blood_pressure = true
tflite_micro = true
gas_sensor = true
barometric_pressure = true
gsr = true

[power]
pmic = max77734
battery_chemistry = solid_state_lipo
charging_method = nfc_inductive
charging_frequency_mhz = 13.56

[power.base]
battery_mah = 15
energy_harvesting = piezoelectric_mems
target_battery_life_days = 4

[power.ultra]
battery_mah = 25
target_battery_life_days = 7

[ml_models.ultra]
arrhythmia = models/arrhythmia_int8.tflite
sleep_staging = models/sleep_staging_int8.tflite
stress_scoring = models/stress_int8.tflite
blood_pressure = models/bp_estimation_int8.tflite
ml_runtime = tflite_micro
ml_processor = max32666

[ble_services]
health_monitoring = 0x181D
activity = 0x1814
sleep = custom
stress = custom
device_info = 0x180A
ota_update = custom

[build]
optimization = Os
debug_uart = true
debug_baud = 115200
