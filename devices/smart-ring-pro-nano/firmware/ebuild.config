# eBuild Configuration — Smart Ring Pro Nano Firmware
# EmbeddedOS Build System v2.1

[project]
name = smart-ring-pro-nano
version = 0.1.0
description = "Smart Ring Pro Nano — Ultra-thin health monitoring ring firmware"
inventor = "Srikanth Patchava"
organization = "Embedded Operating Systems Research Foundation"

[board]
target = smart-ring-pro-nano-rev-a
mcu = nrf52833
rtos = zephyr-3.6
toolchain = arm-none-eabi-gcc-13.2

[features]
ble = true
ble_version = 5.1
ota = true
nfc_charging = true
energy_harvesting = true
ecg = true
ppg_3wavelength = true
temperature = true
imu = true
gsr = true
haptic = false

[sensors]
ppg_ic = max30101
ecg_ic = max30001
temp_ic = max30208
imu_ic = lsm6dso

[power]
pmic = max77734
battery_mah = 15
battery_chemistry = solid_state_lipo
charging_method = nfc_inductive
charging_frequency_mhz = 13.56
energy_harvesting = piezoelectric_mems
target_battery_life_days = 4

[ml_models]
arrhythmia_lite = models/arrhythmia_lite_int8.tflite
sleep_lite = models/sleep_lite_int8.tflite
ml_runtime = tflite_micro
ml_processor = nrf52833

[ble_services]
health_monitoring = 0x181D
activity = 0x1814
device_info = 0x180A
ota_update = custom

[build]
optimization = Os
debug_uart = true
debug_baud = 115200
flash_size_kb = 512
ram_size_kb = 128
